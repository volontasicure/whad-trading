# Chiavi Alpaca (Trading API, paper trading) — SOLO lato server, non hanno prefisso VITE_
# quindi non vengono mai incluse nel bundle del browser.
#
# Dove trovarle: https://app.alpaca.markets/paper/dashboard/overview -> "API Keys"
#
# NON committare un file .env / .env.local con valori reali: sono già in .gitignore.
# Impostale invece su Vercel (Project Settings -> Environment Variables) o localmente
# con `vercel env pull .env.local` dopo averle salvate lì.

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "paper" (default) oppure "live"
ALPACA_ENV=paper

# Segreto condiviso che autentica le chiamate di Vercel Cron alle funzioni /api/cron/*.
# Vercel aggiunge da solo l'header "Authorization: Bearer <CRON_SECRET>" quando questa
# variabile è impostata — genera un valore casuale qualsiasi, non è legato a nessun account.
CRON_SECRET=

# Segreto condiviso con lo scheduler esterno (GitHub Actions, .github/workflows/tick.yml)
# per autenticare le chiamate a /api/cron/tick. A differenza di CRON_SECRET, questo va
# impostato a mano sia qui sia come secret del repository GitHub (stesso valore).
TICK_SECRET=

# Impostata automaticamente da Vercel quando si collega il database Postgres (Neon) dal
# marketplace — non va mai impostata a mano.
POSTGRES_URL=
